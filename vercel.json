{
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/app", "destination": "/api/index" },
    { "source": "/download", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/app/api/(.*)", "destination": "/api/index" },
    { "source": "/manifest.webmanifest", "destination": "/api/index" },
    { "source": "/sw.js", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/v1/(.*)", "destination": "/api/index" }
  ]
}
