[Unit]
Description=Hybrid AI Edge Node memory sync worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/Users/patu/Documents/CursorProjects/telefon
Environment=EDGE_NODE_CONFIG=/Users/patu/Documents/CursorProjects/telefon/software/config/device.yaml
ExecStart=/Users/patu/Documents/CursorProjects/telefon/.venv/bin/python /Users/patu/Documents/CursorProjects/telefon/software/services/sync_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
