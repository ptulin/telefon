[Unit]
Description=Hybrid AI Edge Node UI and orchestration service
After=network-online.target ollama.service ModemManager.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/Users/patu/Documents/CursorProjects/telefon
Environment=EDGE_NODE_CONFIG=/Users/patu/Documents/CursorProjects/telefon/software/config/device.yaml
ExecStart=/Users/patu/Documents/CursorProjects/telefon/.venv/bin/python -m software.app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
